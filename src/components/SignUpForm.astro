---
// Sign Up / Onboarding Form Component
---

<section
  id="signup"
  class="py-24 bg-gradient-to-br from-primary/5 to-secondary/5 dark:from-slate-900 dark:to-slate-950 relative overflow-hidden transition-colors duration-300"
>
  <div class="container mx-auto px-4 md:px-6 relative z-10">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-bold text-custom-bg dark:text-white mb-4 tracking-tight"
      >
        Get Your Free US Address
      </h2>
      <p class="text-xl text-gray-500 dark:text-gray-400 font-light">
        Sign up in minutes and start shopping from any US store. We'll handle
        the shipping to Guyana!
      </p>
    </div>

    <div class="max-w-2xl mx-auto">
      <!-- Sign Up Form -->
      <div
        class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl p-8 lg:p-10 border border-gray-100 dark:border-slate-700"
      >
        <form id="signupForm" class="space-y-6">
          <!-- Name Field -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label
                for="firstName"
                class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2"
                >First Name *</label
              >
              <input
                type="text"
                id="firstName"
                name="firstName"
                required
                class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700 focus:ring-2 focus:ring-primary focus:border-transparent dark:text-white transition-all duration-300"
                placeholder="John"
              />
            </div>
            <div>
              <label
                for="lastName"
                class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2"
                >Last Name *</label
              >
              <input
                type="text"
                id="lastName"
                name="lastName"
                required
                class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700 focus:ring-2 focus:ring-primary focus:border-transparent dark:text-white transition-all duration-300"
                placeholder="Doe"
              />
            </div>
          </div>

          <!-- Email Field -->
          <div>
            <label
              for="email"
              class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2"
              >Email Address *</label
            >
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700 focus:ring-2 focus:ring-primary focus:border-transparent dark:text-white transition-all duration-300"
              placeholder="your.email@example.com"
            />
          </div>

          <!-- Password Field -->
          <div>
            <label
              for="password"
              class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2"
              >Password *</label
            >
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                minlength="8"
                class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700 focus:ring-2 focus:ring-primary focus:border-transparent dark:text-white transition-all duration-300 pr-12"
                placeholder="Min. 8 characters"
              />
              <button
                type="button"
                id="toggle-password"
                class="absolute inset-y-0 right-0 px-3 flex items-center text-gray-400 hover:text-gray-600"
                aria-label="Show password"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                  ></path>
                </svg>
              </button>
            </div>
          </div>

          <!-- Confirm Password Field -->
          <div>
            <label
              for="confirmPassword"
              class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2"
              >Confirm Password *</label
            >
            <div class="relative">
              <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                required
                class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700 focus:ring-2 focus:ring-primary focus:border-transparent dark:text-white transition-all duration-300 pr-12"
                placeholder="Confirm your password"
              />
              <button
                type="button"
                id="toggle-confirm-password"
                class="absolute inset-y-0 right-0 px-3 flex items-center text-gray-400 hover:text-gray-600"
                aria-label="Show confirm password"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                  ></path>
                </svg>
              </button>
            </div>
          </div>

          <!-- Phone Field -->
          <div>
            <label
              for="phone"
              class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2"
              >Phone Number (Guyana) *</label
            >
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700 focus:ring-2 focus:ring-primary focus:border-transparent dark:text-white transition-all duration-300"
              placeholder="+592 000-0000"
            />
          </div>

          <!-- Address Field (Optional) -->
          <div>
            <label
              for="address"
              class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2"
              >Delivery Address in Guyana (Optional)</label
            >
            <textarea
              id="address"
              name="address"
              rows="2"
              class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700 focus:ring-2 focus:ring-primary focus:border-transparent dark:text-white transition-all duration-300 resize-none"
              placeholder="Enter your street address if you'd like home delivery"
            ></textarea>
          </div>

          <!-- City Selection -->
          <div>
            <label
              for="city"
              class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2"
              >Preferred Pickup Location *</label
            >
            <select
              id="city"
              name="city"
              required
              class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700 focus:ring-2 focus:ring-primary focus:border-transparent dark:text-white transition-all duration-300"
            >
              <option value="">Select your city</option>
              <option value="Georgetown">Georgetown</option>
              <option value="Mabaruma">Mabaruma</option>
            </select>
          </div>

          <!-- Referral Field (Optional) -->
          <div>
            <label
              for="referralCode"
              class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2"
              >Referred by someone? Enter their Customer Code (Optional)</label
            >
            <div class="relative">
              <input
                type="text"
                id="referralCode"
                name="referralCode"
                maxlength="20"
                autocomplete="off"
                class="w-full px-4 py-3 rounded-xl bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700 focus:ring-2 focus:ring-primary focus:border-transparent dark:text-white transition-all duration-300 pr-12 font-mono uppercase placeholder:font-sans placeholder:normal-case"
                placeholder="e.g. MGG123456"
                aria-describedby="referralHint"
              />
              <span
                id="referralStatusIcon"
                class="absolute inset-y-0 right-0 px-3 flex items-center pointer-events-none"
                aria-hidden="true"
              ></span>
            </div>
            <p
              id="referralHint"
              class="mt-2 text-xs text-gray-500 dark:text-gray-400"
            >
              Your friend earns $1,000 GYD off their next shipment once you
              place and pay for your first order. Leave blank if you don't
              have one.
            </p>
          </div>

          <!-- Error Message -->
          <div
            id="errorMessage"
            class="hidden p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl text-red-700 dark:text-red-400 text-sm"
          >
          </div>

          <!-- Success Message -->
          <div
            id="successMessage"
            class="hidden p-4 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-xl text-green-700 dark:text-green-400 text-sm text-center"
          >
            <p class="font-semibold mb-2">Account Created Successfully!</p>
            <p>Your US shipping address will be sent to your email shortly.</p>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="submitBtn"
            class="w-full bg-primary text-white px-6 py-4 rounded-xl hover:bg-primary/90 transition-all duration-300 font-bold text-lg shadow-lg hover:shadow-primary/30 transform hover:-translate-y-0.5 disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none"
          >
            Create My Account
          </button>

          <!-- Login Link -->
          <p class="text-center text-sm text-gray-500 dark:text-gray-400">
            Already have an account?
            <a
              href="/auth/login"
              class="text-primary hover:text-primary/80 font-medium transition-colors"
            >
              Sign in here
            </a>
          </p>
        </form>
      </div>

      <!-- Benefits -->
      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div
          class="flex items-center gap-3 p-4 bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700"
        >
          <div
            class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300"
            >Free US Address</span
          >
        </div>
        <div
          class="flex items-center gap-3 p-4 bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700"
        >
          <div
            class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300"
            >Fast Shipping</span
          >
        </div>
        <div
          class="flex items-center gap-3 p-4 bg-white dark:bg-slate-800 rounded-xl border border-gray-100 dark:border-slate-700"
        >
          <div
            class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300"
            >Customs Handled</span
          >
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupPasswordToggle(toggleId: string, inputId: string) {
    const toggle = document.getElementById(toggleId);
    const input = document.getElementById(inputId) as HTMLInputElement;

    if (toggle && input) {
      toggle.addEventListener("click", () => {
        const type =
          input.getAttribute("type") === "password" ? "text" : "password";
        input.setAttribute("type", type);

        if (type === "text") {
          toggle.innerHTML = `
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
            </svg>
          `;
        } else {
          toggle.innerHTML = `
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          `;
        }
      });
    }
  }

  setupPasswordToggle("toggle-password", "password");
  setupPasswordToggle("toggle-confirm-password", "confirmPassword");

  const form = document.getElementById("signupForm") as HTMLFormElement;
  const errorMessage = document.getElementById("errorMessage");
  const successMessage = document.getElementById("successMessage");
  const submitBtn = document.getElementById("submitBtn");

  // ---- Referral code (Customer Code) live validation ----
  const referralInput = document.getElementById(
    "referralCode",
  ) as HTMLInputElement | null;
  const referralHint = document.getElementById("referralHint");
  const referralStatusIcon = document.getElementById("referralStatusIcon");

  const REFERRAL_HINT_DEFAULT =
    referralHint?.textContent || "Leave blank if you don't have one.";

  // 'idle' (empty), 'checking', 'valid', 'invalid'
  let referralState: "idle" | "checking" | "valid" | "invalid" = "idle";
  let referralDebounceTimer: number | undefined;

  function setReferralHint(message: string, tone: "default" | "error" | "success") {
    if (!referralHint) return;
    referralHint.textContent = message;
    referralHint.classList.remove("text-red-600", "dark:text-red-400", "text-green-600", "dark:text-green-400");
    if (tone === "error") {
      referralHint.classList.add("text-red-600", "dark:text-red-400");
    } else if (tone === "success") {
      referralHint.classList.add("text-green-600", "dark:text-green-400");
    }
  }

  function setReferralIcon(state: "idle" | "checking" | "valid" | "invalid") {
    if (!referralStatusIcon) return;

    if (state === "checking") {
      referralStatusIcon.innerHTML = `
        <svg class="w-5 h-5 animate-spin text-gray-400" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
        </svg>
      `;
    } else if (state === "valid") {
      referralStatusIcon.innerHTML = `
        <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      `;
    } else if (state === "invalid") {
      referralStatusIcon.innerHTML = `
        <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      `;
    } else {
      referralStatusIcon.innerHTML = "";
    }
  }

  async function checkReferralCode() {
    const code = (referralInput?.value || "").trim();

    if (!code) {
      referralState = "idle";
      setReferralHint(REFERRAL_HINT_DEFAULT, "default");
      setReferralIcon("idle");
      referralInput?.classList.remove("border-red-300", "dark:border-red-700", "border-green-300", "dark:border-green-700");
      return;
    }

    referralState = "checking";
    setReferralIcon("checking");
    setReferralHint("Checking Customer Code...", "default");

    try {
      const res = await fetch(
        `/api/public/validate-referral?code=${encodeURIComponent(code)}`,
      );
      const data = await res.json();

      // Input may have changed while the request was in flight.
      if ((referralInput?.value || "").trim() !== code) return;

      if (data.valid) {
        referralState = "valid";
        referralInput?.classList.remove("border-red-300", "dark:border-red-700");
        referralInput?.classList.add("border-green-300", "dark:border-green-700");
        setReferralIcon("valid");
        setReferralHint(
          data.referrerName
            ? `Referral confirmed for ${data.referrerName}. Thank them for the invite!`
            : "Customer Code found.",
          "success",
        );
      } else {
        referralState = "invalid";
        referralInput?.classList.remove("border-green-300", "dark:border-green-700");
        referralInput?.classList.add("border-red-300", "dark:border-red-700");
        setReferralIcon("invalid");
        setReferralHint(
          data.error || "Customer Code not found. Please double-check it.",
          "error",
        );
      }
    } catch {
      // Network hiccup: don't block the user, the server re-validates anyway.
      referralState = "idle";
      setReferralIcon("idle");
      setReferralHint(REFERRAL_HINT_DEFAULT, "default");
    }
  }

  referralInput?.addEventListener("input", () => {
    // Normalize to uppercase so the visible value matches Customer Codes.
    const start = referralInput.selectionStart;
    referralInput.value = referralInput.value.toUpperCase();
    if (start !== null) referralInput.setSelectionRange(start, start);

    window.clearTimeout(referralDebounceTimer);
    referralDebounceTimer = window.setTimeout(checkReferralCode, 450);
  });

  referralInput?.addEventListener("blur", () => {
    window.clearTimeout(referralDebounceTimer);
    checkReferralCode();
  });

  function showError(message: string) {
    if (errorMessage) {
      errorMessage.textContent = message;
      errorMessage.classList.remove("hidden");
    }
    if (successMessage) {
      successMessage.classList.add("hidden");
    }
  }

  function hideError() {
    if (errorMessage) {
      errorMessage.classList.add("hidden");
    }
  }

  function showSuccess() {
    if (successMessage) {
      successMessage.classList.remove("hidden");
    }
    if (errorMessage) {
      errorMessage.classList.add("hidden");
    }
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    hideError();

    const formData = new FormData(form);
    const password = formData.get("password") as string;
    const confirmPassword = formData.get("confirmPassword") as string;

    // Validate passwords match
    if (password !== confirmPassword) {
      showError("Passwords do not match.");
      return;
    }

    // Validate password length
    if (password.length < 8) {
      showError("Password must be at least 8 characters.");
      return;
    }

    // Referral code: block submission if we already know it's invalid, and
    // re-check anything that was typed but never validated.
    if (referralInput) {
      const referralValue = referralInput.value.trim();
      if (referralValue && referralState !== "valid") {
        await checkReferralCode();
        if (referralState === "invalid") {
          showError("Please enter a valid referral Customer Code or leave it blank.");
          referralInput.focus();
          return;
        }
        if (referralState === "checking") {
          // Still resolving: let the server make the final call.
        }
      }
    }

    // Disable button
    if (submitBtn) {
      submitBtn.setAttribute("disabled", "true");
      submitBtn.textContent = "Creating Account...";
    }

    try {
      const response = await fetch("/api/auth/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          firstName: formData.get("firstName"),
          lastName: formData.get("lastName"),
          email: formData.get("email"),
          password: password,
          phone: formData.get("phone"),
          address: formData.get("address"),
          city: formData.get("city"),
          referralCode: (formData.get("referralCode") as string) || "",
        }),
      });

      const data = await response.json();

      if (data.success) {
        showSuccess();
        form.reset();
        // Redirect to dashboard after 2 seconds
        setTimeout(() => {
          window.location.href = "/dashboard";
        }, 2000);
      } else {
        showError(data.error || "Failed to create account. Please try again.");
        if (submitBtn) {
          submitBtn.removeAttribute("disabled");
          submitBtn.textContent = "Create My Account";
        }
      }
    } catch (error) {
      showError("An error occurred. Please try again.");
      if (submitBtn) {
        submitBtn.removeAttribute("disabled");
        submitBtn.textContent = "Create My Account";
      }
    }
  });
</script>
