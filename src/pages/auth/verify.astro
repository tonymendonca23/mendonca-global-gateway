---
import {
  verifyMagicLink,
  createSession,
  setSessionCookie,
} from "../../lib/auth";
import db from "../../lib/db";
import { nanoid } from "nanoid";
import { generateWarehouseAddress } from "../../lib/warehouse";
import { ensureCustomerCode } from "../../lib/referral";

const token = Astro.url.searchParams.get("token");

if (!token) {
  return Astro.redirect("/auth/login?error=invalid_token", 302);
}

// Verify the magic link
const result = await verifyMagicLink(token);

if (!result.success || !result.email) {
  return Astro.redirect("/auth/login?error=invalid_or_expired", 302);
}

const { email, isStaff } = result;

// Check if user exists
const table = isStaff ? "staff" : "users";
const existingUser = await db.execute({
  sql: `SELECT id FROM ${table} WHERE email = ?`,
  args: [email],
});

let userId: string;

if (existingUser.rows.length === 0) {
  // Auto-create new customers
  if (!isStaff) {
    userId = nanoid();
    const warehouseAddress = generateWarehouseAddress(email.split("@")[0], null);

    await db.execute({
      sql: `INSERT INTO users (id, email, name, us_warehouse_address) VALUES (?, ?, ?, ?)`,
      args: [userId, email, email.split("@")[0], warehouseAddress],
    });
  } else {
    // Staff must be created manually
    return Astro.redirect("/admin/login?error=not_authorized", 302);
  }
} else {
  userId = existingUser.rows[0].id as string;
}

// Magic-link signups bypass the registration form, so make sure the user
// has a Customer Code (also their referral code).
try {
  await ensureCustomerCode(userId);
} catch (err) {
  console.warn("⚠️ Failed to assign customer code:", err);
}

// Create session
const sessionToken = await createSession(userId, isStaff || false);

// Set cookie
setSessionCookie(Astro.cookies, sessionToken, isStaff || false);

// Redirect to dashboard
const dashboardPath = isStaff ? "/admin" : "/dashboard";
return Astro.redirect(dashboardPath, 302);
---
